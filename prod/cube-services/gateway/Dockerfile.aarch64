FROM nexus.guhecloud.com:5000/ghcloud/bun-ci:1.3 AS builder

USER bun

ARG BRANCH=main

WORKDIR /app

RUN mkdir -p -m 0700 ~/.ssh

COPY --chown=bun:bun ./id_rsa /home/bun/.ssh/

RUN chmod 600 ~/.ssh/id_rsa && ssh-keyscan git.guhecloud.com >> ~/.ssh/known_hosts

RUN rm -rf /app/ghcloud

RUN cd /app && git clone -b ${BRANCH} git@git.guhecloud.com:ghcloud/ghcloud.git

RUN cd /app/ghcloud && bun install --frozen-lockfile --production --ignore-scripts

RUN cd /app/ghcloud && bun --cwd=prod/cube-services/gateway run build:node

FROM nexus.guhecloud.com:5000/node:24.14.1-slim AS bff-gateway

WORKDIR /app

COPY --from=builder /app/ghcloud/prod/cube-services/gateway/dist/cube-bff-gw.mjs /app/

USER bun

EXPOSE 3000/tcp

ENTRYPOINT ["/app/cube-bff-gw.mjs"]
