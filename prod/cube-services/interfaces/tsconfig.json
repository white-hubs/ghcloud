{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": [
      "ESNext"
    ],
    "target": "ESNext",
    "module": "esnext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    // Library build & project references
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "./src",
    "outDir": "./lib",
    // Bundler / modern module behavior (for consumers that需要)
    "moduleResolution": "bundler",
    // "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Emit
    "noEmit": false,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@ghcloud/cube-service-interface/base": [
        "./src/base/*"
      ],
      "@ghcloud/cube-service-interface/video-monitor": [
        "./src/video-monitor/*"
      ],
      "@ghcloud/cube-service-interface/device-center": [
        "./src/device-center/*"
      ],
      "@ghcloud/cube-service-interface/access-control": [
        "./src/access-control/*"
      ],
      "@ghcloud/cube-service-interface/template-demo": [
        "./src/template-demo/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "lib",
    "node_modules"
  ]
}
