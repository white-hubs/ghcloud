    "test": "bun test"
  },
  "dependencies": {
    "@dangao/bun-server": "catalog:bun-server",
    "@modelcontextprotocol/sdk": "catalog:",
    "@mozilla/readability": "catalog:",
    "cheerio": "catalog:backend-jq",
    "fast-xml-parser": "catalog:",
    "iconv-lite": "catalog:",
    "linkedom": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:cube-ai"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
