{
  "name": "@ghcloud/cube-fetch-service",
  "module": "./src/main.ts",
  "main": "./src/main.ts",
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "start": "bun debug.ts",
    "dev": "bun --watch debug.ts",
    "mcp:stdio": "bun src/mcp-stdio.ts",
