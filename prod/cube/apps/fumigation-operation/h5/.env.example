# =============================================================================
# 熏蒸作业 H5 环境变量示例
# -----------------------------------------------------------------------------
# - .env.dev / .env.test / .env.prod 已纳入仓库，构建时按 --mode 加载
# - 浏览器独立调试鉴权可写入 .env.local（已被 .gitignore）
# =============================================================================

# 构建产物 publicPath（与 H5 路由 base 一致）
# PUBLIC_PATH=/apps/fumigation-operation/h5

# 应用码，需与 BFF / OUAA 权限系统一致
# VITE_APPLICATION_CODE=FUMIGATION_OPERATION

# 是否启用 vConsole（dev/test 建议 true，prod 建议 false）
# V_CONSOLE=true

# 浏览器独立调试（可选，写入 .env.local，勿提交真实 token）
# AUTH_HEADERS={"Authorization":"Bearer <token>"}
# APP_USER={"id":"<userId>","name":"<userName>"}
