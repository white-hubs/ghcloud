# =============================================================================
# 熏蒸作业 PC 子应用环境变量示例
# -----------------------------------------------------------------------------
# - .env.dev / .env.test / .env.prod 已纳入仓库，构建时按 --mode 加载
# - 本地私有覆盖请使用 .env.local（已被 .gitignore）
# =============================================================================

# 构建产物 publicPath（与主应用静态资源部署路径一致）
# PUBLIC_PATH=/apps/@ghcloud/cube-fumigation-operation-app

# 应用码，需与 BFF / OUAA 权限系统一致
# VITE_APPLICATION_CODE=FUMIGATION_OPERATION

# 是否启用 mock 数据（仅本地调试；主应用 qiankun 模式不装配 mock）
# VITE_USE_MOCK=true
