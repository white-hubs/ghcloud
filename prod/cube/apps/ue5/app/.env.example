# 复制为 .env.dev 后按需修改。
# Cube 静态托管入口为 /apps/ue5（对应访问 URL：…/apps/ue5/），须与 PUBLIC_PATH 一致，
# 否则 index.html 会去请求 /ue5/assets/* 导致 404。
#
# bun run dev          → --mode dev   → .env.dev
# bun run build:prod   → --mode prod  → .env.prod
# bun run build:test   → --mode test  → .env.test
# bun run build:cnp    → --mode cnp   → .env.cnp

PUBLIC_PATH=/apps/ue5
VITE_BASE_API=https://ai.fjhw.com.cn/api
# 可选：阿里云天气市场 APPCODE，用于自动天气；未配置则跳过第三方请求并使用默认天气
# VITE_ALIYUN_WEATHER_APPCODE=
# VITE_WEB_SOCKET="wss://bimops-dev-manage.guhecloud.com:30000/api/message/websocket/msg"
