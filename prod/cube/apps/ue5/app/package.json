    "build:cnp": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build -c vite.build.config.ts --mode cnp",
    "preview": "vite preview -c vite.preview.config.ts",
    "check:structure": "node scripts/check-structure.mjs",
    "check:no-vue": "node scripts/check-no-vue.mjs",
    "check:no-vue:shell": "node scripts/check-no-vue.mjs --shell",
