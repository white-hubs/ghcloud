# =============================================================================
# 智能粮情 H5 环境变量示例
# -----------------------------------------------------------------------------
# - 本文件是唯一进入仓库的 .env 文件
# - 其余 .env / .env.* 均已被 .gitignore，按需本地创建
# - 具体机制见 docs/adr/0007-env-strategy.md
# =============================================================================

# 构建产物的 publicPath，默认 `/`
# 由 CI / nginx / H5 部署配置按需覆盖，不加 VITE_ 前缀（构建侧变量）
# PUBLIC_PATH=/

# 应用码，需与 BFF / OUAA 权限系统一致
VITE_APPLICATION_CODE=INTELLIGENT_GRAIN

# 是否启用 vConsole
# V_CONSOLE=true

# 浏览器独立调试鉴权（可选，写入本地 .env.local，勿提交真实 token）
# AUTH_HEADERS={"Authorization":"Bearer <token>"}
# APP_USER={"id":"<userId>","name":"<userName>"}
