# =============================================================================
# 智能粮情本地 test 环境变量
# -----------------------------------------------------------------------------
# 本文件被 .gitignore 忽略，仅用于本机 test mode。
# =============================================================================

# 构建产物的 publicPath，测试部署有特殊前缀时在本地按需改写。
PUBLIC_PATH=/apps/@ghcloud/cube-intelligent-grain-app

# 应用码，需与 BFF 权限系统一致。
VITE_APPLICATION_CODE=INTELLIGENT_GRAIN

# test mode 默认接真实接口；需要本地 mock 时改成 true。
VITE_USE_MOCK=false
