# =============================================================================
# 智能粮情本地 dev 环境变量
# -----------------------------------------------------------------------------
# 本文件被 .gitignore 忽略，仅用于本机 dev mode。
# =============================================================================

# 构建产物的 publicPath，开发部署有特殊前缀时在本地按需改写。
PUBLIC_PATH=/apps/@ghcloud/cube-intelligent-grain-app

# 应用码，需与 BFF 权限系统一致。
VITE_APPLICATION_CODE=INTELLIGENT_GRAIN

# dev mode 默认启用 mock；接真实接口时改成 false。
VITE_USE_MOCK=true
