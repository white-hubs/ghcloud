
# 构建产物公共资源路径
PUBLIC_PATH=/apps/@ghcloud/cube-ai-application-app

# Vite dev server 代理上游（网关根地址，如 https://cube-dev.guhecloud.com:30000/）
DEV_PROXY_TARGET=https://ai-center-prebuilt.cube-ai-project.orb.local/

# ── qiankun + 本地 ai-center ───────────────────────────────────────────────
# 子应用挂在 mf-root 时相对 `/api/ai-center` 会打到主壳网关；本地联调请改为绝对 URL：
# VITE_AI_CENTER_API_BASE=http://localhost:8890/api/ai-center
# façade 与 assistant 均从此 base 派生（assistant 用 `${base}/agent`）
VITE_AI_CENTER_API_BASE=http://localhost:8890/api/ai-center
