{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strict": true,
    "noImplicitReturns": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "allowUmdGlobalAccess": false,
    "verbatimModuleSyntax": true,
    "newLine": "lf",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@cube-scada/core": ["../../../scada/basic/core/src/index.ts"],
      "@cube-scada/studio-sdk": ["../../../scada/basic/studio-sdk/src/index.ts"],
      "@cube-scada/engine": ["../../../scada/basic/engine/src/index.ts"],
      "@cube-scada/elements": ["../../../scada/basic/elements/src/index.ts"],
      "@cube-scada/renderer": ["../../../scada/basic/renderer/src/index.ts"],
      "@cube-scada/runtime": ["../../../scada/basic/runtime/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx"],
  "references": [{ "path": "./tsconfig.node.json" }],
  "vueCompilerOptions": {
    "jsxTemplates": true,
    "experimentalRfc436": true
  }
}
