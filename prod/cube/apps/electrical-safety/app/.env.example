# =============================================================================
# 电气安全管理环境变量示例
# -----------------------------------------------------------------------------
# - 本文件是唯一进入仓库的 .env 文件
# - 其余 .env / .env.* 均已被 .gitignore，按需本地创建
# - 具体机制见 docs/adr/0007-env-strategy.md
# =============================================================================

# 构建产物的 publicPath；本地启动默认 `/`，构建默认使用主应用部署路径
# 由 CI / nginx / 主应用部署配置按需覆盖，不加 VITE_ 前缀（构建侧变量）
# PUBLIC_PATH=/

# 应用码，需与 BFF 权限系统一致
VITE_APPLICATION_CODE=ELECTRICAL_SAFETY

# 是否启用 mock 数据
# - dev 默认 true（见 vite.config.ts#useMock）
# - build:prod 默认 false
# VITE_USE_MOCK=true

# 二维组态本地联调（独立运行 electrical-safety 时）
# - 组态 REST 默认走网关；本机 scada-studio-service 可改为 http://localhost:3100
# VITE_DEV_SCADA_API_PROXY=http://localhost:3100
# - 组态静态资源默认转发到本机 scada-studio（默认 :8899）
# VITE_DEV_SCADA_STUDIO_STATIC_TARGET=http://localhost:8899
