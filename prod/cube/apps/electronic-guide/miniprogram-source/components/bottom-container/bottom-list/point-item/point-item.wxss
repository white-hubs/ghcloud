.point-item {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
  background: #f8f8f8;
  border-radius: 8px;
  padding: 24rpx;
  font-size: 26rpx;
  box-shadow: 0px 0px 6px 0px rgba(0, 0, 0, 0.16);
  border: 1px solid #f8f8f8;
}

.point-item.active {
  border: 1px solid #006b3a;
  border-radius: 8px;
}

.point-item .merchant-png {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.point-item .content {
  flex: 1;
  display: flex;
  height: 120rpx;
  flex-direction: column;
  justify-content: space-between;
}

.point-item .content .title {
  color: #222;
  font-size: 28rpx;
  font-family: Source Han Sans CN, Source Han Sans CN-Medium;
  font-weight: Medium;
}

.point-item .content .address {
  display: flex;
  align-items: center;
  font-family: Source Han Sans CN, Source Han Sans CN-Regular;
  font-weight: Regular;
  color: #7c8380;
  font-size: 20rpx;
}

.point-item .content .address .icon {
  width: 20rpx;
  height: 20rpx;
  margin-right: 12rpx;
}

.point-item .right {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  height: 120rpx;
}

.point-item .right .share {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.point-item .right .share image {
  width: 28rpx;
  height: 28rpx;
}

.point-item .right .share .share-btn {
  font-size: 24rpx;
  width: auto;
  color: #006B3A;
  padding: 0;
  background-color: transparent;
  border-radius: 0;
  margin-right: 0 !important;
  margin-left: auto;
  line-height: initial;
}

.point-item .right .share .share-btn::after {
  border: none;
}

.point-item .right .right-nav {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  padding: 16rpx;
  background: #006B3A;
  border-radius: 12rpx;
  color: #fff;
  font-size: 24rpx;
}

.point-item .right .right-nav .nav-png {
  width: 20rpx;
  margin-right: 10rpx;
  height: 24rpx;
  vertical-align: middle;
}