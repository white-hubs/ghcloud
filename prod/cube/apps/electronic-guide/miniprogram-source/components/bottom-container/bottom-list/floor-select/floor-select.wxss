.floor-select {
  width: 100%;
}
.triangle-container {
  width: 60rpx;
  height: 80rpx;
  display: inline-block;
  background: rgba(255, 255, 255, 0.7);
  position: relative;
  box-shadow: 0px 0px 4px 0px rgba(0, 0, 0, 0.03);
}
.triangle-container .triangle {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  margin-top: 70%;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid #d0ddea;
}
.bg-container {
  position: absolute;
  top: 109rpx;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.3);
}
.bg-container .floor-list {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
  background: #fff;
  padding: 0 60rpx 0 32rpx;
  padding-bottom: 24rpx;
}
.bg-container .floor-list .floor-item {
  padding: 16rpx;
  background: #f2f2f2;
  text-align: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-family: Source Han Sans CN, Source Han Sans CN-Regular;
  font-weight: Regular;
  color: #1f3140;
}
.bg-container .floor-list .floor-item.active {
  background: #e1f4e9;
  color: #006b3a;
}
.floor-select-list {
  display: inline-block;
  width: 80%;
  white-space: nowrap;
  padding: 14rpx 20rpx;
}
.floor-select-list .list-item {
  font-size: 12px;
  display: inline-block;
  margin-right: 24rpx;
  font-family: Source Han Sans CN, Source Han Sans CN-Regular;
  font-weight: Regular;
  text-align: left;
  color: #1f3140;
  padding: 12rpx 32rpx;
  background: #f8f8f8;
  border-radius: 4px;
}
.floor-select-list .list-item.active {
  background: #e1f4e9;
  color: #006b3a;
}
