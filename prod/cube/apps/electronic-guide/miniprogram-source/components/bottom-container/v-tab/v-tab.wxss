.tab-container {
	width: 100%;
	box-sizing: border-box;
	overflow: hidden;
	position: relative;
}

.tab-scroll-view {
	width: 100%;
}

.tab-content {
	display: inline-flex;
	white-space: nowrap;
	background: #fbfbfb;
	height: 35px;
	padding: 0;
	min-width: 100%;
	position: relative;
	align-items: center;
	overflow: hidden;
}

.tab-item {
	flex-shrink: 0;
	display: flex;
	align-items: center;
	height: 100%;
	position: relative;
	transition: all 0.3s;
	white-space: nowrap;
	font-size: 14px;
	padding: 0 11px;
}

.tab-item.active {
	color: #006B3A;
	font-weight: bold;
}

.tab-line {
	background: #006B3A;
	height: 5px;
	position: absolute;
	bottom: 0;
	left: 0;
	transition: all 0.3s ease;
	border-radius: 5px;
}