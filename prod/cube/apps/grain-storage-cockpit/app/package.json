{
  "name": "@ghcloud/cube-grain-storage-cockpit-app",
  "version": "1.0.2",
  "description": "集团储量安全驾驶舱 Cube 微应用",
  "private": false,
  "files": [
    "dist/"
  ],
  "type": "module",
  "publishConfig": {
    "registry": "http://nexus.guhecloud.com:8888/repository/npm-hosted/"
  },
  "scripts": {
    "dev": "vite -c vite.dev.config.ts --mode dev",
    "build": "vite build -c vite.build.config.ts",
    "build:dev": "vite build -c vite.build.config.ts --mode dev",
    "build:test": "vite build -c vite.build.config.ts --mode test",
    "build:prod": "vite build -c vite.build.config.ts --mode prod",
    "preview": "vite preview -c vite.preview.config.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ghcloud/cube-services-client": "workspace:^",
    "@ghcloud/cube-theme": "workspace:^",
    "@ghcloud/cube-ui": "workspace:^",
    "@ghcloud/logger": "workspace:^",
    "echarts": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "less": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-html": "catalog:",
    "vite-plugin-qiankun": "catalog:",
    "vue-tsc": "catalog:"
  }
}
