UxiPoULeOxCzohc6grMnHd\"}},\"PeW6dgs00owAAyxgXQccTIQUnUb\":{\"id\":\"PeW6dgs00owAAyxgXQccTIQUnUb\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"author\":\"6977280661891842051\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"云计算（Cloud Computing）是一种计算资源交付模型，集成了各种服务器、应用程序、数据和其它资源，并通过互联网以服务的形式提供这些资源。\"},\"attribs\":{\"0\":\"*0+21\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"6977280661891842051\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\"}},\"SoAedgG4IoS8cOx4FvqcwZJPnpg\":{\"id\":\"SoAedgG4IoS8cOx4FvqcwZJPnpg\",\"snapshot\":{\"parent_id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\",\"type\":\"ordered\",\"children\":[],\"comments\":[],\"author\":\"6977280661891842051\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"大数据\"},\"attribs\":{\"0\":\"*0*1+3\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"6977280661891842051\"],\"1\":[\"bold\",\"true\"]},\"nextNum\":2}},\"folded\":false,\"seq\":\"auto\"}},\"WOuGdWy4UomsoSxDV2CcsMmhnNH\":{\"id\":\"WOuGdWy4UomsoSxDV2CcsMmhnNH\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"author\":\"6977280661891842051\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"大数据（Big Data）是指以容量大、类型多、存取速度快、应用价值高为主要特征的数据集合。\"},\"attribs\":{\"0\":\"*0+1a\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"6977280661891842051\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\"}},\"MiIIdWyIWoWqmOxG0yAcP60EnZe\":{\"id\":\"MiIIdWyIWoWqmOxG0yAcP60EnZe\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"author\":\"6977280661891842051\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"数字孪生使用这些数据的一种模式就是通过机器学习技术，在物理机理不明确、输入数据不完备的情况下对数字孪生的未来状态和行为进行预测\"},\"attribs\":{\"0\":\"*0+1r\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"6977280661891842051\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\"}},\"WaYsdsqe0o8kEExsvYycgTs5nHc\":{\"id\":\"WaYsdsqe0o8kEExsvYycgTs5nHc\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"author\":\"6977280661891842051\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"大数据必须采用分布式架构，对海量数据进行分布式数据挖掘，因此必须依托云计算的分布式处理、分布式数据库和云存储、虚拟化技术。大数据的主要特征为：数据量巨大，数据类型多，数据流动快，数据潜在价值大。\"},\"attribs\":{\"0\":\"*0+2p\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"6977280661891842051\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\"}},\"VuYmd6MY0oGeCAxC9x6c2bOCndb\":{\"id\":\"VuYmd6MY0oGeCAxC9x6c2bOCndb\",\"snapshot\":{\"parent_id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\",\"type\":\"ordered\",\"children\":[],\"comments\":[],\"author\":\"6977280661891842051\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"人工智能\"},\"attribs\":{\"0\":\"*0*1+4\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"6977280661891842051\"],\"1\":[\"bold\",\"true\"]},\"nextNum\":2}},\"folded\":false,\"seq\":\"auto\"}},\"JqUAdGIOMoOQk0xGZCKcLoLZn1J\":{\"id\":\"JqUAdGIOMoOQk0xGZCKcLoLZn1J\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"author\":\"6977280661891842051\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"人工智能（Artificial Intelligence，简称 AI）是研究、开发用于模拟、延伸和扩展人的智能的理论、方法、技术及应用系统的一门新的技术科学。人工智能的应用可能会出现在工业互联网的各个环节，尤其是在数据应用的环节。\"},\"attribs\":{\"0\":\"*0+37\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"6977280661891842051\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\"}},\"HGCQdakMSoy6Amxc5CnczBTLnEc\":{\"id\":\"HGCQdakMSoy6Amxc5CnczBTLnEc\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"author\":\"6977280661891842051\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"将数字孪生系统与机器学习框架学习结合，数字孪生系统可以根据多重的反馈源数据进行自我学习，从而几乎实时 地在数字世界里呈现物理实体的真实状况，并能够对即将发生的事件进行推测和预演。数字孪生系统的自我学习除了可以依赖于传感器的反馈信息，也可以通过历史数据，或者是集成网络的数据学习，在不断的自我学习与迭代中，模拟精度和速度将大幅提升。\"},\"attribs\":{\"0\":\"*0+4l\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"6977280661891842051\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\"}},\"SKiidU2GaoIuksx6Broclp7bnUc\":{\"id\":\"SKiidU2GaoIuksx6Broclp7bnUc\",\"snapshot\":{\"parent_id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\",\"type\":\"ordered\",\"children\":[],\"comments\":[],\"author\":\"6977280661891842051\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"区块链\"},\"attribs\":{\"0\":\"*0*1+3\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"6977280661891842051\"],\"1\":[\"bold\",\"true\"]},\"nextNum\":2}},\"folded\":false,\"seq\":\"auto\"}},\"Vuwcdcqgio6oWoxYV1EcNMvpn1d\":{\"id\":\"Vuwcdcqgio6oWoxYV1EcNMvpn1d\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"author\":\"6977280661891842051\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"本质上是一种解决信任问题、降低信任成本的信息技术方案。\"},\"attribs\":{\"0\":\"*0+r\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"6977280661891842051\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\"}},\"U4guda4OYoUOC0x29eKcxmqfnJc\":{\"id\":\"U4guda4OYoUOC0x29eKcxmqfnJc\",\"snapshot\":{\"parent_id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\",\"type\":\"ordered\",\"children\":[],\"comments\":[],\"author\":\"6977280661891842051\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"5G (第五代移动通信技术)\"},\"attribs\":{\"0\":\"*0+4*0*1+a\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"6977280661891842051\"],\"1\":[\"bold\",\"true\"]},\"nextNum\":2}},\"folded\":false,\"seq\":\"auto\"}},\"UguydMmQUoua0wxEFQ0c2nCinoe\":{\"id\":\"UguydMmQUoua0wxEFQ0c2nCinoe\",\"snapshot\":{\"type\":\"text\",\"children\":[],\"comments\":[],\"author\":\"6977280661891842051\",\"text\":{\"initialAttributedTexts\":{\"text\":{\"0\":\"5G是具有高速率、低时延和大连接特点的新一代宽带移动通信技术，5G 网络的场景应用包括：增强移动宽带、海量机器类通信、高可靠&amp;低时延通信。\"},\"attribs\":{\"0\":\"*0+1x\"}},\"apool\":{\"numToAttrib\":{\"0\":[\"author\",\"6977280661891842051\"]},\"nextNum\":1}},\"folded\":false,\"parent_id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\"}},\"D8iwdUxiPoULeOxCzohc6grMnHd\":{\"id\":\"D8iwdUxiPoULeOxCzohc6grMnHd\",\"snapshot\":{\"type\":\"page\",\"parent_id\":\