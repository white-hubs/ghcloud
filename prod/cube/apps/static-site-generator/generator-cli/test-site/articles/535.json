ns gb\", \"microsoft yahei\", stheiti, \"wenquanyi micro hei\", simsun, sans-serif;font-size:13px;text-wrap:wrap;background-color:#ffffff;\" /><br style=\"box-sizing:border-box;color:#666666;font-family:\"lantinghei sc\", \"open sans\", arial, \"hiragino sans gb\", \"microsoft yahei\", stheiti, \"wenquanyi micro hei\", simsun, sans-serif;font-size:13px;text-wrap:wrap;background-color:#ffffff;\" /><span style=\"color:#666666;font-family:\"lantinghei sc\", \"open sans\", arial, \"hiragino sans gb\", \"microsoft yahei\", stheiti, \"wenquanyi micro hei\", simsun, sans-serif;font-size:13px;text-wrap:wrap;background-color:#ffffff;\">5、消防系统：打开火灾报警点所在楼层及上、下楼层的消防紧急照明；</span><br style=\"box-sizing:border-box;color:#666666;font-family:\"lantinghei sc\", \"open sans\", arial, \"hiragino sans gb\", \"microsoft yahei\", stheiti, \"wenquanyi micro hei\", simsun, sans-serif;font-size:13px;text-wrap:wrap;background-color:#ffffff;\" /><br style=\"box-sizing:border-box;color:#666666;font-family:\"lantinghei sc\", \"open sans\", arial, \"hiragino sans gb\", \"microsoft yahei\", stheiti, \"wenquanyi micro hei\", simsun, sans-serif;font-size:13px;text-wrap:wrap;background-color:#ffffff;\" /><span style=\"color:#666666;font-family:\"lantinghei sc\", \"open sans\", arial, \"hiragino sans gb\", \"microsoft yahei\", stheiti, \"wenquanyi micro hei\", simsun, sans-serif;font-size:13px;text-wrap:wrap;background-color:#ffffff;\">6、BA系统：启用正压风机；</span><br style=\"box-sizing:border-box;color:#666666;font-family:\"lantinghei sc\", \"open sans\", arial, \"hiragino sans gb\", \"microsoft yahei\", stheiti, \"wenquanyi micro hei\", simsun, sans-serif;font-size:13px;text-wrap:wrap;background-color:#ffffff;\" /><br style=\"box-sizing:border-box;color:#666666;font-family:\"lantinghei sc\", \"open sans\", arial, \"hiragino sans gb\", \"microsoft yahei\", stheiti, \"wenquanyi micro hei\", simsun, sans-serif;font-size:13px;text-wrap:wrap;background-color:#ffffff;\" /><span style=\"color:#666666;font-family:\"