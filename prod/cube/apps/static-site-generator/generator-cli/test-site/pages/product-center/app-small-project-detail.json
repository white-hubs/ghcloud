    {
      "name": "RichText",
      "props": {
        "content": "<div style=\"padding: 1.875vw 18.75vw;\"><h2 style='font-size: 24px; font-weight: bold; color: #262626; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px solid #f0f0f0; text-align: left;' id='product-intro'>产品介绍</h2><p style=\"text-align: left;\"><span style=\"color: rgb(38, 38, 38); font-size: 15px;\">小散工程系统，统一管理园区小散工程类项目，从项目立项到项目的施工验收，全流程监管，实现项目透明化，给管理者决策提供数据支撑。区别于一般的工程管理系统，该功能应用主要侧重于工程的安全监管。</span></p><p style=\"text-align: center;\"><img src=\"https://cube.guhecloud.com:3000/minio/ouaa/1965374451954495489.png\" alt=\"\" data-href=\"\" style=\"display:inline-block;width: 50%;\"></p>",
        "background": "gray"
      }
