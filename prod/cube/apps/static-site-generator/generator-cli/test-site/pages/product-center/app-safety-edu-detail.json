    {
      "name": "RichText",
      "props": {
        "content": "<div style=\"padding: 1.875vw 18.75vw;\"><h2 style='font-size: 24px; font-weight: bold; color: #262626; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px solid #f0f0f0; text-align: left;' id='product-intro'>产品介绍</h2><p style=\"text-align: left;\"><span style=\"font-size: 15px;\">统一管理园区内的培训、考试场景，通过建立培训任务、考试任务并下发给相关人员，实现线上无纸质化培训、考试，并在事后建立相关统计报表，协助建立内部的培训学习机制。</span></p>",
