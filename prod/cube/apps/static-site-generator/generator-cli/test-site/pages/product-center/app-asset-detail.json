    {
      "name": "RichText",
      "props": {
        "content": "<div style=\"padding: 1.875vw 18.75vw;\"><h2 style='font-size: 24px; font-weight: bold; color: #262626; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px solid #f0f0f0; text-align: left;' id='product-intro'>产品介绍</h2><p style=\"text-align: left;\"><span style=\"color: rgb(38, 38, 38); font-size: 15px;\">资产信息化管理，包含固定资产管理、耗材管理，从资产入库、派发、调拨、报废实现资产全生命周期管理，提供资产盘点的能力，辅助内部半自动化盘点，减少现场人力投入。</span></p>",
        "background": "gray"
