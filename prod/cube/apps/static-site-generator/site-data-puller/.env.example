# generator-config API 基础地址
# generator-config 开发时代理到 https://cube-dev.guhecloud.com:30000/api
# 生产环境请替换为实际网关地址
SSG_API_BASE_URL=https://cube-dev.guhecloud.com:30000/api/guhecloudWebsite

# 访问令牌（Bearer Token）
# 从浏览器 sessionStorage 的 GH-Token 中取值：JSON.parse(sessionStorage.getItem('GH-Token')).access_token
SSG_API_TOKEN=

# 租户 ID（tenant Header）
# 从浏览器 sessionStorage 的 GH-NowEnterprise 中取值：JSON.parse(sessionStorage.getItem('GH-NowEnterprise')).code
SSG_API_TENANT=

# 终端标识（terminal Header），generator-config 使用 CubeTerminalEnum.BUSINESS
SSG_API_TERMINAL=bimops-manage-web

# 输出目录
SSG_OUTPUT_DIR=./dist

# 输出文件夹名，留空则使用 site-<timestamp>
# SSG_SITE_DIR_NAME=site-20260630092422

# 文章分页大小
SSG_PAGE_SIZE=100

# 请求间隔（毫秒）
SSG_RATE_LIMIT_MS=150

# 设置为 1 时只打印待请求接口，不真正调用
# SSG_DRY_RUN=1
