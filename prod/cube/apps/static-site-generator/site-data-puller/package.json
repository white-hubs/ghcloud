{
  "name": "@ghcloud/cube-site-data-puller",
  "version": "1.0.0",
  "description": "Pull static site business data from generator-config APIs and pack into ZIP",
  "type": "module",
  "private": true,
  "scripts": {
    "pull": "bun src/main.ts",
