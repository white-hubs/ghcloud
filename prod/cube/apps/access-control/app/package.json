    "@ghcloud/cube-utils": "workspace:^",
    "@ghcloud/logger": "workspace:^",
    "dayjs": "catalog:",
    "echarts": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "less": "catalog:",
    "typescript": "catalog:",
