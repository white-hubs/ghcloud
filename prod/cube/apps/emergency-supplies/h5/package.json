    "@ghcloud/logger": "workspace:^",
    "pinia": "catalog:",
    "vant": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
